<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description rdf:about="" xmlns:stereo="https://stereoscopy.org/ns/stereo/1.0/" stereo:Format="anaglyph">
      <stereo:ViewSet>
        <rdf:Seq>
          <rdf:li rdf:parseType="Resource">
            <stereo:Perspective>left-eye</stereo:Perspective>
            <stereo:AnaglyphComponent>red</stereo:AnaglyphComponent>
            <stereo:Primary>True</stereo:Primary>
          </rdf:li>
          <rdf:li rdf:parseType="Resource">
            <stereo:Perspective>right-eye</stereo:Perspective>
            <stereo:AnaglyphComponent>cyan</stereo:AnaglyphComponent>
          </rdf:li>
        </rdf:Seq>
      </stereo:ViewSet>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
